{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell_command|functions\\.shell_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CODEX_HOME_WINDOWS_ESCAPED}}\\hooks\\pre_tool_use_policy.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CODEX_HOME_WINDOWS_ESCAPED}}\\hooks\\stop_continue_guard.py\""
          }
        ]
      }
    ]
  }
}
