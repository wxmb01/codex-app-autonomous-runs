{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex App Autonomous Promotion Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "repository",
    "version",
    "status",
    "promotion",
    "validation",
    "install_result",
    "git",
    "github",
    "reviewer",
    "steps"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pending",
        "passed",
        "failed",
        "dry-run",
        "skipped"
      ]
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories",
        "changed_files",
        "candidate_files",
        "validation_policy"
      ],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "project-local",
              "global-prompt",
              "global-validation",
              "global-safety",
              "release",
              "documentation",
              "performance"
            ]
          }
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "install_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "codex_home",
        "manifest_version"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "dry-run",
            "skipped"
          ]
        },
        "codex_home": {
          "type": "string",
          "minLength": 1
        },
        "manifest_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit_sha",
        "tag"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "push_result",
        "release"
      ],
      "properties": {
        "push_result": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "command": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "release": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "release_url": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "used",
        "agent_type",
        "result",
        "findings"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "used": {
          "type": "boolean"
        },
        "agent_type": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string"
        },
        "findings": {
          "type": "string"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "reviewer_required_for_categories": [
    "global-prompt",
    "global-validation",
    "performance"
  ]
}
